{
  "name": "lushtresses",
  "version": "1.0.0",
  "private": true,
  "description": "LushTresses — luxury human hair and hair accessories e-commerce storefront",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:diff": "prisma migrate diff --from-empty --to-schema-datamodel prisma/schema.prisma --script",
    "icons": "node scripts/generate-icons.mjs",
    "setup": "prisma migrate deploy && prisma db seed && node scripts/generate-icons.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@ducanh2912/next-pwa": "10.2.9",
    "@next-auth/prisma-adapter": "1.0.7",
    "@paypal/react-paypal-js": "10.6.1",
    "@prisma/client": "6.19.3",
    "@stripe/react-stripe-js": "7.0.1",
    "@stripe/stripe-js": "10.2.0",
    "bcryptjs": "3.0.3",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "lucide-react": "1.62.0",
    "next": "15.5.28",
    "next-auth": "4.24.15",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "resend": "6.34.1",
    "stripe": "23.0.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.15.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "15.5.28",
    "prisma": "6.19.3",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "webpack": "5.112.2"
  },
  "engines": {
    "node": ">=20.11.0"
  }
}
