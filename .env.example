# ─────────────────────────────────────────────────────────────
# LushTresses — environment variables
# Copy to .env (local) and add the same keys in Vercel → Settings → Environment Variables
# ─────────────────────────────────────────────────────────────

# ── Database (Prisma Postgres / Neon / Supabase / any PostgreSQL 14+) ──
# Direct TCP connection string shown in the Prisma Postgres console.
DATABASE_URL="postgres://USER:PASSWORD@db.prisma.io:5432/postgres?sslmode=require"
# Optional direct (non-pooled) URL used by `prisma migrate`. Defaults to DATABASE_URL.
DIRECT_URL="postgres://USER:PASSWORD@db.prisma.io:5432/postgres?sslmode=require"

# ── Auth (required) ──
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET="replace-me-with-a-32-byte-random-string"
NEXTAUTH_URL="http://localhost:3000"

# ── Google OAuth (optional — the Google button hides when unset) ──
# Authorised redirect URI: {NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Stripe (optional — card / Apple Pay / Google Pay hide when unset) ──
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# stripe listen --forward-to localhost:3000/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=""

# ── PayPal (optional) ──
NEXT_PUBLIC_PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""
PAYPAL_ENV="sandbox"

# ── Transactional email (optional — emails are logged as SKIPPED when unset) ──
EMAIL_PROVIDER="resend"
RESEND_API_KEY=""
SENDGRID_API_KEY=""
EMAIL_FROM="LushTresses <hello@lushtresses.com>"
ADMIN_NOTIFICATION_EMAIL="orders@lushtresses.com"

# ── Site ──
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_BRAND_NAME="LushTresses"
NEXT_PUBLIC_SUPPORT_EMAIL="hello@lushtresses.com"
NEXT_PUBLIC_SUPPORT_PHONE="+44 20 7946 0958"
NEXT_PUBLIC_INSTAGRAM_URL="https://instagram.com/lushtresses"

# ── Seed accounts (used by `npm run db:seed`) ──
SEED_ADMIN_EMAIL="admin@lushtresses.com"
SEED_ADMIN_PASSWORD="LushAdmin2026!"
SEED_CUSTOMER_EMAIL="customer@example.com"
SEED_CUSTOMER_PASSWORD="LushCustomer2026!"

# ── Checkout safety ──
# Development-only manual "Pay in test mode" method. Ignored in production builds.
ALLOW_DEMO_PAYMENTS="true"
# Protects /api/cron/expire-orders (Vercel Cron sends this as a Bearer token)
CRON_SECRET=""
