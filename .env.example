# ─────────────────────────────────────────────────────────────
# The Elites House — environment variables
# Copy to .env (local) and add the same keys in Vercel → Settings → Environment Variables
# ─────────────────────────────────────────────────────────────

# ── Database (Prisma Postgres / Neon / Supabase / any PostgreSQL 14+) ──
# Prisma Postgres gives you two strings under *Connect*: a pooled one for the app
# (pgbouncer, port 5432 on pooled.db.prisma.io) and a direct one for migrations.
DATABASE_URL="postgres://USER:PASSWORD@pooled.db.prisma.io:5432/postgres?sslmode=require"
# Used by `prisma migrate deploy` / `db push` / `studio`. The Vercel build only runs
# `prisma generate`, which tolerates its absence — but set it in Vercel (Production AND
# Preview) so CI or a local migration against production reuses the same values.
DIRECT_URL="postgres://USER:PASSWORD@db.prisma.io:5432/postgres?sslmode=require"

# ── Auth (required) ──
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET="$2a$15$9z8h.vtW3W1wGGmTnoZ7wuk7NWq92vh2yJ.k9Q95efuRYAUiCYgZy"
NEXTAUTH_URL="http://localhost:3000"

# ── Google OAuth (optional — the Google button hides when unset) ──
# Authorised redirect URI: {NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Stripe (optional — card / Apple Pay / Google Pay hide when unset) ──
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# stripe listen --forward-to localhost:3000/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=""

# ── PayPal (optional) ──
NEXT_PUBLIC_PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""
PAYPAL_ENV="sandbox"

# ── Transactional email (optional — emails are logged as SKIPPED when unset) ──
# EMAIL_PROVIDER: "smtp" (mailbox on your host), "resend" or "sendgrid".
EMAIL_PROVIDER="smtp"
# SMTP mailbox — port 465 = SSL, 587 = STARTTLS (then set SMTP_SECURE="false").
SMTP_HOST="premium709.web-hosting.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="orders@theeliteshouse.com"
SMTP_PASSWORD=""
# Resend / SendGrid — only used when EMAIL_PROVIDER points at them.
RESEND_API_KEY=""
SENDGRID_API_KEY=""
# Order mail is sent from this mailbox; reply-to for support templates is contact@.
EMAIL_FROM="The Elites House <orders@theeliteshouse.com>"
ADMIN_NOTIFICATION_EMAIL="orders@theeliteshouse.com"

# ── Media uploads (optional — dev falls back to public/uploads) ──
# Vercel → Storage → Create Blob store → connect it to this project. Connecting
# injects BLOB_READ_WRITE_TOKEN into Production, Preview and Development; pull it
# locally with `vercel env pull .env.local` (or paste it below).
BLOB_READ_WRITE_TOKEN=""
# Force a storage adapter: "vercel-blob" or "local". Default = Blob when a token
# is present, local disk otherwise. Production refuses the disk fallback.
MEDIA_PROVIDER=""
# Per-file ceiling in bytes (default 4 MB). Stay under Vercel's ~4.5 MB body cap.
MEDIA_MAX_BYTES="4194304"

# ── Site ──
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_BRAND_NAME="The Elites House"
# Public support/contact inbox (shown in the footer, emails and JSON-LD).
NEXT_PUBLIC_CONTACT_EMAIL="contact@theeliteshouse.com"
NEXT_PUBLIC_SUPPORT_EMAIL="contact@theeliteshouse.com"
# Order enquiries: returns, exchanges, gift cards, admin order alerts.
NEXT_PUBLIC_ORDERS_EMAIL="orders@theeliteshouse.com"
NEXT_PUBLIC_SUPPORT_PHONE="+44 20 7946 0958"
NEXT_PUBLIC_INSTAGRAM_URL="https://instagram.com/theeliteshouse"

# ── Seed accounts (used by `npm run db:seed`) ──
SEED_ADMIN_EMAIL="admin@theeliteshouse.com"
SEED_ADMIN_PASSWORD="LushAdmin2026!"
SEED_CUSTOMER_EMAIL="customer@example.com"
SEED_CUSTOMER_PASSWORD="LushCustomer2026!"

# ── Checkout safety ──
# Development-only manual "Pay in test mode" method. Ignored in production builds.
ALLOW_DEMO_PAYMENTS="true"
# Protects /api/cron/expire-orders (Vercel Cron sends this as a Bearer token)
CRON_SECRET=""
